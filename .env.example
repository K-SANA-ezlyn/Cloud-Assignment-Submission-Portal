# =====================================================================
# Cloud-Based Student Assignment Submission & Feedback Portal
# LOCAL MODE configuration — copy this file to `.env` and edit.
# In local mode, EVERYTHING runs on your machine. No internet, no
# credit card, no cloud account needed.
# =====================================================================

# ----- Application -----
APP_NAME="Cloud Assignment Submission Portal"
ENVIRONMENT=local
API_HOST=0.0.0.0
API_PORT=8000

# ----- Security secrets (GENERATE YOUR OWN — never commit .env) -----
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ----- Role management -----
# Needed only when registering a TEACHER account. Keep private.
TEACHER_INVITE_CODE=TEACHER-2026-DEMO

# ----- Demo seeder passwords (dummy accounts; change if you like) -----
SEED_TEACHER_PASSWORD=Teacher@12345
SEED_STUDENT_PASSWORD=Student@12345

# ----- Database (CLOUD ABSTRACTION LAYER) -----
# local mode  -> SQLite file on disk
# cloud mode  -> Supabase Postgres connection string
DATABASE_URL=sqlite:///./portal.db

# ----- Storage (CLOUD ABSTRACTION LAYER) -----
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ----- Auth provider (LOCAL MODE uses its own JWT issuing) -----
AUTH_PROVIDER=local

# ----- CORS: allowed frontend origins (comma separated) -----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ----- Rate limiting -----
RATE_LIMIT_DEFAULT=100/minute

# =====================================================================
# CLOUD MODE (Supabase free tier) — fill ONLY when deploying.
# See docs/cloud-deployment.md for a step-by-step guide.
# =====================================================================
# DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
# STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=<service-role-key-keep-secret>
# SUPABASE_STORAGE_BUCKET=submissions
# AUTH_PROVIDER=supabase
# SUPABASE_ANON_KEY=<anon-public-key>

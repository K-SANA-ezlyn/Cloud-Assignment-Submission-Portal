# =====================================================================
# CLOUD MODE configuration — free-tier services (Supabase)
# Copy to `.env` on your hosting provider (Render) and fill in values
# from your Supabase project dashboard. No credit card required.
# =====================================================================

APP_NAME="Cloud Assignment Submission Portal"
ENVIRONMENT=cloud
API_HOST=0.0.0.0
API_PORT=8000

# Generate your own:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

TEACHER_INVITE_CODE=TEACHER-2026-DEMO

# ---- Supabase Postgres (free tier) ----
# Dashboard -> Project Settings -> Database -> Connection string (URI, pooler)
DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---- Supabase Storage (free tier, private bucket) ----
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key-keep-secret>
SUPABASE_STORAGE_BUCKET=submissions
MAX_FILE_SIZE_MB=10

# ---- Supabase Auth (optional managed auth mode) ----
AUTH_PROVIDER=supabase
SUPABASE_ANON_KEY=<anon-public-key>

# ---- CORS: your deployed frontend origin ----
CORS_ORIGINS=https://<your-app>.vercel.app,http://localhost:5173

RATE_LIMIT_DEFAULT=100/minute
